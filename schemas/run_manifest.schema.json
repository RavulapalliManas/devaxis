{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "devaxis run manifest",
  "type": "object",
  "required": ["run_id", "init_seed", "task", "model", "bs", "lr", "wd", "warmup",
               "p_schedule", "steps", "eval_every", "out_dir"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "parent_run_id": {"type": ["string", "null"]},
    "fork_step": {"type": ["integer", "null"]},
    "resume_ckpt": {"type": "string"},
    "init_seed": {"type": "integer"},
    "task": {"type": "object", "required": ["K", "D"],
             "properties": {"K": {"type": "integer", "minimum": 1},
                            "D": {"type": "integer", "minimum": 0}}},
    "vocab": {"type": "object",
              "properties": {"ne": {"type": "integer"}, "no": {"type": "integer"},
                             "nd": {"type": "integer"}}},
    "model": {"type": "object", "required": ["d", "nl", "nh"],
              "properties": {"d": {"type": "integer"}, "nl": {"type": "integer"},
                             "nh": {"type": "integer"}}},
    "attn": {"enum": ["mha", "explicit"]},
    "bs": {"type": "integer", "minimum": 1},
    "lr": {"type": "number", "exclusiveMinimum": 0},
    "wd": {"type": "number", "minimum": 0},
    "warmup": {"type": "integer", "minimum": 1},
    "p_schedule": {"type": ["string", "number"]},
    "steps": {"type": "integer", "minimum": 1},
    "eval_every": {"type": "integer", "minimum": 1},
    "logit_every": {"type": "integer"},
    "ckpt_every": {"type": "integer"},
    "ckpt_at": {"type": "array", "items": {"type": "integer"}},
    "stop_at": {"type": "number"},
    "precision": {"enum": ["fp32", "fp64", "bf16_autocast"]},
    "data_streams": {"type": "array",
                     "items": {"type": "object", "required": ["from_step", "stream_id"],
                               "properties": {"from_step": {"type": "integer"},
                                              "stream_id": {"type": "string"}}}},
    "condition": {"type": "object",
                  "properties": {"recurrence": {"enum": ["none", "exact", "paraphrase"]},
                                 "rate": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                                 "pool_size": {"type": "integer", "minimum": 1},
                                 "interval": {"type": "integer", "minimum": 1},
                                 "order": {"enum": ["fixed", "scrambled"]}}},
    "allow_recompile": {"type": "boolean"},
    "reset_optimizer": {"type": "boolean"},
    "lr_rewarm": {"type": "boolean"},
    "audit_mode": {"type": "boolean"},
    "out_dir": {"type": "string"}
  }
}
